APP_NAME="Laravel Business Starter Kit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — MySQL 8+ with utf8mb4 (04_Tech_Stack.md §3)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=starter_kit
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Starter Kit — product identity
# ---------------------------------------------------------------------------
STARTER_KIT_NAME="Laravel Business Starter Kit"
STARTER_KIT_EDITION=Community
STARTER_KIT_COMPANY="Laravel Business Starter Kit"
STARTER_KIT_COMPANY_EMAIL=support@example.com

# ---------------------------------------------------------------------------
# Authentication (17_Authentication_Module.md)
# ---------------------------------------------------------------------------
AUTH_REGISTRATION_ENABLED=true
AUTH_EMAIL_VERIFICATION_REQUIRED=true
AUTH_DEFAULT_ROLE=Viewer

AUTH_PASSWORD_MIN_LENGTH=10
AUTH_PASSWORD_REQUIRE_UPPERCASE=true
AUTH_PASSWORD_REQUIRE_LOWERCASE=true
AUTH_PASSWORD_REQUIRE_NUMBERS=true
AUTH_PASSWORD_REQUIRE_SYMBOLS=true

AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DECAY_MINUTES=15
AUTH_INVALIDATE_SESSIONS_ON_PASSWORD_CHANGE=true

# Seeded administrator account
ADMIN_FIRST_NAME=Avery
ADMIN_LAST_NAME=Sinclair
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="Password!2345"

# ---------------------------------------------------------------------------
# Dashboard (18_Dashboard_Module.md)
# ---------------------------------------------------------------------------
DASHBOARD_CACHE_TTL=300
DASHBOARD_RECENT_ACTIVITY_LIMIT=8
DASHBOARD_RECENT_USERS_LIMIT=5

# ---------------------------------------------------------------------------
# Media (16_Media_System.md)
# ---------------------------------------------------------------------------
MEDIA_DISK=public
MEDIA_DIRECTORY=media
MEDIA_MAX_UPLOAD_SIZE=5120
MEDIA_AVATAR_MAX_SIZE=2048
MEDIA_IMAGE_QUALITY=82
MEDIA_IMAGE_MAX_WIDTH=2400

# ---------------------------------------------------------------------------
# Theme (05_Design_System.md)
# ---------------------------------------------------------------------------
THEME_DEFAULT_MODE=system

LOGIN_HISTORY_RETENTION_DAYS=90
